themes {
  eldritch {
    text_unselected { base "#c0caf5" background "#1a1b26" }
    text_selected { base "#1a1b26" background "#7aa2f7" }

    ribbon_unselected { base "#9ece6a" background "#32344a" }
    ribbon_selected { base "#1a1b26" background "#9ece6a" }

    table_title { base "#7dcfff" background "#16161e" }
    table_cell_unselected { base "#a9b1d6" background "#16161e" }
    table_cell_selected { base "#1a1b26" background "#7aa2f7" }

    exit_code_success { base "#9ece6a" }
    exit_code_error { base "#f7768e" }

    frame_highlight { base "#ff9e64" background "#16161e" }
    list_selected { base "#e0af68" background "#2d4260" }

    multiplayer_user_colors {
      player_1 "#7aa2f7"
      player_2 "#9ece6a" 
      player_3 "#e0af68"
      player_4 "#bb9af7"
      player_5 "#7dcfff"
    }

    emphasis_0 "#f7768e"  // Error red
    emphasis_1 "#9ece6a"  // Success green
    emphasis_2 "#7dcfff"  // Info cyan
    emphasis_3 "#bb9af7"  // Purple accent
  }
}

