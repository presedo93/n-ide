[core]
	editor = nvim
  pager = "diff-so-fancy"
  excludesFile = ~/.gitignore

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[filter "git-ignore"]
	clean = "sed '/#\\s*git-ignore$/d'"
	smudge = cat

[init]
	defaultBranch = main

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true

[merge]
  conflictstyle = zdiff3

[fetch]
  prune = true

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[user]
  name = Rene Presedo
	email = presedo93@gmail.com

[advice]
	skippedCherryPicks = false
