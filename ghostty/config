# Theme:
theme = "Catppuccin Mocha"

# Font configuration:
font-family="Cartograph CF"
font-size=13
font-thicken=true
font-thicken-strength=32

adjust-font-baseline=80%
adjust-cell-width=10%
adjust-cell-height=30%
adjust-underline-position=6
adjust-underline-thickness=40%
adjust-cursor-thickness=150%

alpha-blending=linear
background-opacity=0.86
background-blur=20

# Cursor:
cursor-color=F8F8F2
cursor-style-blink=false
cursor-text=000000
shell-integration-features=no-cursor

# Let me close stuff in peace:
confirm-close-surface=false

# Brighter:
bold-color=bright

# Hide titlebar:
macos-titlebar-style="hidden"

# Enable URLs:
link-url=true

# Treat the option key as alt:
macos-option-as-alt=true

# No shadow looks cleaner:
macos-window-shadow=false

# It's annoying:
mouse-hide-while-typing=true

# To keep background:
macos-non-native-fullscreen=true
