{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "mcp": {
    "grep": {
      "url": "https://mcp.grep.app",
      "type": "remote",
      "enabled": true
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "type": "remote",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  }
}
